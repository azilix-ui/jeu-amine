# Cache les fichiers techniques : seuls les cours et les jeux sont visibles en ligne.
<FilesMatch "(\.md|^package\.json|^build\.js|^\.gitignore)$">
  Require all denied
</FilesMatch>

# La porte du site (acces/, 13/11/2026) : chaque page .html, chaque dossier et les photos de famille passent par acces/porte.php,
# qui laisse entrer les appareils de confiance (maison, Anis, invités) quand la protection est activée. Les images des jeux restent libres.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^$ acces/porte.php [L]
  RewriteCond %{REQUEST_URI} !^/acces/
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule \.html$ acces/porte.php [L]
  RewriteCond %{REQUEST_URI} !^/acces/
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule /$ acces/porte.php [L]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^photos/ acces/porte.php [L]
</IfModule>

# Les jeux d'Amine ont déménagé dans /amine/ : les anciens liens continuent de marcher.
Redirect 301 /la-nuit-d-amine.html /amine/la-nuit-d-amine.html
Redirect 301 /la-nuit-d-amine-2.html /amine/la-nuit-d-amine-2.html
Redirect 301 /nahki-tounsi.html /amine/nahki-tounsi.html

# Toujours vérifier la dernière version des pages : les navigateurs (Chrome sur tablette surtout)
# ne gardent plus une vieille copie du site après une mise à jour.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
</IfModule>
# Application installable : le manifeste et le service worker
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
  Header always set X-Famille-Missaoui "1"
  <FilesMatch "\.(html|css|js|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
